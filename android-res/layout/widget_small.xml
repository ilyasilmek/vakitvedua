<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:text="Öğle vaktine" />
        <TextView android:id="@+id/w_place" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF" android:textSize="11sp" android:maxLines="1" android:text="Gebze" />
    </LinearLayout>
    <Chronometer android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
    <TextView android:id="@+id/w_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#D9FFFFFF" android:textSize="12sp" android:text="Öğle 12:59" />
</LinearLayout>
